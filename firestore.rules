rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Security helper functions
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isValidUserId(userId) {
      return userId is string && 
             userId.size() > 0 && 
             userId.size() <= 128 &&
             userId.matches('^[a-zA-Z0-9_-]+$');
    }
    
    function hasValidUserData(data) {
      return data.keys().hasAll(['userId']) &&
             data.userId is string &&
             data.userId == request.auth.uid;
    }
    
    function isRecentRequest() {
      return request.time <= timestamp.date(2025, 12, 31);
    }

    // DENY ALL by default - explicit allow only
    match /{document=**} {
      allow read, write: if false;
    }

    // Food database - READ ONLY for all users (public food data)
    match /foods/{foodId} {
      allow read: if true;
      allow write: if false; // No writes allowed to food database
    }
    
    // User-specific food entries (calorie tracking)
    match /foodEntries/{entryId} {
      allow read, write: if isAuthenticated() && 
        isRecentRequest() &&
        (
          (resource != null && isOwner(resource.data.userId)) ||
          (request.resource != null && 
           hasValidUserData(request.resource.data) &&
           isOwner(request.resource.data.userId))
        );
    }
    
    // User profiles and personal data
    match /users/{userId} {
      allow read, write: if isAuthenticated() && 
        isOwner(userId) && 
        isValidUserId(userId) &&
        isRecentRequest();
      
      // User's fitness data (nested under user document)
      match /fitnessData/{dataId} {
        allow read, write: if isAuthenticated() && 
          isOwner(userId) && 
          isValidUserId(userId) &&
          isRecentRequest();
      }
      
      // User's workout data (nested under user document)
      match /workouts/{workoutId} {
        allow read, write: if isAuthenticated() && 
          isOwner(userId) && 
          isValidUserId(userId) &&
          isRecentRequest();
      }
      
      // User's workout plans (nested under user document)
      match /workoutPlans/{planId} {
        allow read, write: if isAuthenticated() && 
          isOwner(userId) && 
          isValidUserId(userId) &&
          isRecentRequest();
      }
    }
    
    // User goals (separate collection for easier querying)
    match /userGoals/{userId} {
      allow read, write: if isAuthenticated() && 
        isOwner(userId) && 
        isValidUserId(userId) &&
        isRecentRequest();
    }
  }
}
